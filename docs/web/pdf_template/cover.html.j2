<article id="doc-cover">
<style>
  article#doc-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100vh;
    padding: 60px 80px;
    box-sizing: border-box;
    background: #ffffff;
  }
  article#doc-cover .institution { font-size: 12pt; color: #555; margin-bottom: 4px; }
  article#doc-cover .course      { font-size: 11pt; color: #777; margin-bottom: 50px; }
  article#doc-cover .title       { font-size: 24pt; font-weight: bold; color: #1a1a1a; margin-bottom: 10px; }
  article#doc-cover .subtitle    { font-size: 13pt; color: #B41E1E; margin-bottom: 50px; }
  article#doc-cover .rule        { width: 55%; height: 1.5px; background: #B41E1E; margin: 0 auto 36px; }
  article#doc-cover .meta        { font-size: 10pt; color: #555; line-height: 2.2; }
  article#doc-cover .meta strong { color: #1a1a1a; }
  article#doc-cover .footer      { margin-top: 60px; font-size: 9pt; color: #aaa; }
</style>
  <div class="institution">Bachelor in Computer Engineering &#8211; GEISI</div>
  <div class="course">Introduction to Cybersecurity &#8211; TecnoCampus 2025&#8211;2026</div>
  <div class="title">{{ cover_title }}</div>
  <div class="subtitle">{{ cover_subtitle }}</div>
  <div class="rule"></div>
  <div class="meta">
    <strong>Author:</strong> {{ author }}<br/>
    <strong>Supervisor:</strong> Pere Vidiella i Catalan<br/>
    <strong>License:</strong> CC BY-NC-SA 4.0
  </div>
  <div class="footer">https://theegea.github.io/TFG</div>
</article>
